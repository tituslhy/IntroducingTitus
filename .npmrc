# kokoro-js -> @huggingface/transformers pulls in onnxruntime-node, which on Linux x64 (Vercel's build machines)
# tries to download CUDA binaries at install time and fails with a 404. The site never runs ONNX on the server
# (the voice runs in the visitor's browser), so skip them.
onnxruntime-node-install-cuda=skip
