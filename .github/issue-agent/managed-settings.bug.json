{
  "allowManagedPermissionRulesOnly": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write(**/.issue-agent-tmp/**)",
      "Bash(bash .github/issue-agent/thread.sh)",
      "Bash(bash .github/issue-agent/comment.sh)",
      "Bash(bash .github/issue-agent/label.sh add:*)",
      "Bash(bash .github/issue-agent/label.sh remove:*)",
      "Edit",
      "Write",
      "Bash(npm ci)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm test -- :*)",
      "Bash(npx jest :*)",
      "Bash(npm run build)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff main...HEAD)",
      "Bash(git log --oneline -20)",
      "Bash(git checkout -b agent/issue-__ISSUE__-:*)",
      "Bash(git checkout agent/issue-__ISSUE__-:*)",
      "Bash(git checkout main)",
      "Bash(git checkout -)",
      "Bash(git add -A)",
      "Bash(git commit -m :*)",
      "Bash(git stash -u)",
      "Bash(git stash pop)",
      "Bash(git branch -r --list :*)",
      "Bash(bash .github/issue-agent/push.sh)",
      "Bash(bash .github/issue-agent/pr.sh :*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(sudo:*)",
      "Bash(docker:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git diff --output:*)",
      "Edit(**/.github/**)",
      "Write(**/.github/**)",
      "Edit(**/.claude/**)",
      "Write(**/.claude/**)",
      "Edit(**/.git/**)",
      "Write(**/.git/**)",
      "Edit(**/package.json)",
      "Write(**/package.json)",
      "Edit(**/package-lock.json)",
      "Write(**/package-lock.json)",
      "Edit(**/jest.config.*)",
      "Write(**/jest.config.*)",
      "Edit(**/jest.setup.*)",
      "Write(**/jest.setup.*)",
      "Edit(**/eslint.config.*)",
      "Write(**/eslint.config.*)",
      "Edit(**/.eslintrc*)",
      "Write(**/.eslintrc*)"
    ],
    "denyInsteadOfPrompting": true
  },
  "sandbox": {
    "enabled": false
  },
  "env": {
    "npm_config_cache": "/home/runner/.npm"
  }
}
