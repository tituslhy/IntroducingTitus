{
  "allowManagedPermissionRulesOnly": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write(**/.issue-agent-tmp/**)",
      "Bash(bash .github/issue-agent/thread.sh)",
      "Bash(bash .github/issue-agent/comment.sh)",
      "Bash(bash .github/issue-agent/label.sh add:*)",
      "Bash(bash .github/issue-agent/label.sh remove:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(sudo:*)",
      "Bash(docker:*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git diff --output:*)",
      "Edit(**/.github/**)",
      "Write(**/.github/**)",
      "Edit(**/.claude/**)",
      "Write(**/.claude/**)",
      "Edit(**/.git/**)",
      "Write(**/.git/**)",
      "Edit(**/package.json)",
      "Write(**/package.json)",
      "Edit(**/package-lock.json)",
      "Write(**/package-lock.json)",
      "Edit(**/jest.config.*)",
      "Write(**/jest.config.*)",
      "Edit(**/jest.setup.*)",
      "Write(**/jest.setup.*)",
      "Edit(**/eslint.config.*)",
      "Write(**/eslint.config.*)",
      "Edit(**/.eslintrc*)",
      "Write(**/.eslintrc*)"
    ],
    "denyInsteadOfPrompting": true
  },
  "sandbox": {
    "enabled": false
  },
  "env": {
    "npm_config_cache": "/home/runner/.npm"
  }
}
